# ── Zé Treino na VPS — preencha e salve como ".env" ao lado do docker-compose.yml ──

# Domínio que aponta (A record) para o IP público da VM:
SITE_ADDRESS=treino.seudominio.com.br

# Passkeys ficam vinculadas a esse hostname exato — deve ser igual ao SITE_ADDRESS:
RP_ID=treino.seudominio.com.br
ORIGIN=https://treino.seudominio.com.br
RP_NAME=Zé Treino
SESSION_DAYS=90

# Supabase (o mesmo de antes):
DATABASE_URL=postgresql://postgres.REF:SENHA@aws-0-us-west-2.pooler.supabase.com:5432/postgres
